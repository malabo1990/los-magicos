[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/TextoPanel/Margen/VBoxContainer" unique_id=501442391]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "El Braille es un sistema de lectura y escritura para ciegos y personas con baja visión. Se lee con los dedos tocando pequeños puntitos en relieve.
Fue inventado por Louis Braille en 1824, cuando tenía 15 años.
Todo se crea con solo 6 puntitos. Con estos 6 puntos se forman todas las letras, números y signos.

¿Cómo se escribe?
La forma más fácil es con la máquina de Braille.
Esta máquina tiene solo 6 teclas.
Es mucho más simple que un ordenador.
Millones de personas en el mundo leen libros, estudian y escriben gracias al Braille.

Al ver que superaron la primera prueba y conseguir la celda braille interactiva, volvieron a correr juntos, picados por la curiosidad, por la siguiente X."

