[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/Imagen/TextoPanel/Margen/VBoxContainer" unique_id=610964910]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "El inventor sordo

Thomas Edison era casi completamente sordo. Aún así, fue un gran inventor.
Inventó la bombilla eléctrica que duraba mucho tiempo. Gracias a él, hoy tenemos luz eléctrica en casas, calles y escuelas.
Edison decía que su sordera le ayudaba a concentrarse mejor y a pensar con más claridad.

Ángel «encendió» una bombilla imaginaria y ¡brilló de verdad! ¡Y salió confeti por la nueva prueba superada!

Contentos, siguieron en busca de la siguiente prueba hasta que se acercaron a un lago en cuyo centro había una piedra pequeña flotando con un mensaje muy curioso."

