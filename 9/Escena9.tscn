[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/Imagen/TextoPanel/Margen/VBoxContainer" unique_id=1302113410]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "¡La naturaleza también usa signos!
Las abejas bailan para decir dónde está la comida.
Algunos animales usan movimientos para comunicarse. Algunos gorilas y chimpancés aprendieron lengua de signos.
La más famosa fue Koko, una gorila que aprendió más de 1000 signos y hablaba con las manos.
Los animales usan gestos, bailes y movimientos para comunicarse. ¡La naturaleza está llena de signos mágicos!

Para superar la prueba, los niños tuvieron que imitar a las abejas, convertirse en Koko y signar. Y… ¡lo consiguieron!

No podían casi seguir corriendo del ataque de risa que tenían. Cuando se tranquilizaron, siguieron caminando hasta que vieron un teléfono y unos ordenadores."

