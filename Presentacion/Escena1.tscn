theme_override_font_sizes/bold_font_size = 18
bbcode_enabled = true
scroll_active = false
autowrap_mode = 3
text = "[b]David:[/b] Es un niño sordo, parece un indio, siempre en el jardín o en el campo haciendo cabañas, trepando por los árboles, haciendo fuego desde los 4 años, dando de comer a las ovejas y vacas. Sus juguetes favoritos son las piedras, los palos y el barro."

