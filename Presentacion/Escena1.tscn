bbcode_enabled = true
scroll_active = false
autowrap_mode = 3
text = "[b]Casimiro:[/b] Es un niño sordociego, el hermano de Iñaki, tranquilo, cabezón, siempre quiere ser el mejor en el deporte, ser protagonista. Su pasión es el dibujo."

