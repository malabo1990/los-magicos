[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/Imagen/TextoPanel/Margen/VBoxContainer" unique_id=1505470308]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "Hay inventores sordos que cambiaron el mundo:
Robert Weitbrecht inventó el TTY, un teléfono especial para escribir mensajes de texto. Gracias a él, las personas sordas pudieron «hablar» por teléfono por primera vez.
Vint Cerf, que es parcialmente sordo, ayudó a crear Internet. ¡Gracias a él podemos comunicarnos sin problemas por videollamada y conectarnos con todo el mundo!

Para superar esta prueba, tuvieron que realizar una videollamada entre ellos y descubrir que no es una barrera de comunicación.

Sorprendidos con todo lo que estaban descubriendo, caminaron y, en medio del camino, se encontraron una caja negra con una X roja. Ana la abrió y dijo:
—Son implantes cocleares como el que tiene Esti."

