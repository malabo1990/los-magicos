[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/Imagen/TextoPanel/Margen/VBoxContainer" unique_id=250021274]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "Llegaron a una zona con una foto muy grande en la que se veía:

UNIVERSIDAD GALLAUDET
La universidad especial para sordos

La Universidad Gallaudet es la única universidad del mundo solo para personas sordas.
Es muy grande, como un barrio entero. Allí viven y estudian miles de estudiantes sordos.
Todos los profesores y trabajadores saben lengua de signos. Las clases, los juegos, los deportes y las fiestas se hacen en lengua de signos.
Al principio, el jefe de la universidad era oyente, pero en el año 1988 los estudiantes protestaron:
«¡Queremos un jefe sordo!»
¡Y lo consiguieron! Desde entonces, tuvieron un jefe sordo.

Una vez superada la segunda X y conseguir un abecedario dactilológico, siguieron corriendo a por la siguiente prueba."

