[node name="Texto" type="RichTextLabel" parent="maps/MarginContainer/HBoxContainer/Imagen/TextoPanel/Margen/VBoxContainer" unique_id=631261286]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("font_nunito")
theme_override_font_sizes/normal_font_size = 20
text = "La lengua de signos es muy antigua. Ya se usaba en la Grecia antigua, hace más de 2000 años.
En una isla de Estados Unidos llamada Martha's Vineyard, hace muchos años, todos, tanto oyentes como sordos, usaban la lengua de signos. Hasta los abuelos, los niños, todos los vecinos hablaban con las manos. ¡Era normal para todos!

Ana imitó un signo antiguo y salió un fantasma gracioso bailando. Todos se rieron y bailaron con el fantasma.

Nerviosos y contentos, siguieron corriendo hasta una campa verde."

